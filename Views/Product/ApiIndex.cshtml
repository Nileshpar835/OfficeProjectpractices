@model IEnumerable<SimpleMvcApp.Models.Product>

@{
    ViewData["title"] = "Producfghhxfgxxft Catalog";

}
<h1>Productsdfsdd Catalog</h1>
<a asp-controller="Product" asp-action="Create">Add New Product</a>
<table>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Category</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>@product.Category</td>
                <td>
                    @if (product.IsInStock)
                    {
                        <span class="badge bg-success">In Stock</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Out of Stock</span>
                    }
                </td>
                <td>
                    <a asp-controller="Product" asp-action="Delete" asp-route-id="@product.id">Delete</a>
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.id">Details</a>
                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.id">Edit</a>

                </td>
            </tr>
        }
    </tbody>
</table>